{
  "description": "Teamwork - exclusive file ownership, Bash write guard, campaign context, verification gate, audit trail, spawn budget, and progress watch",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/session-context.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "Loading Teamwork charter..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/progress-watch.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "Checking campaign progress..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/ownership-lock.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "Checking file ownership..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/bash-guard.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "Checking shell writes against file ownership..."
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/spawn-budget.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "Checking spawn budget..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/audit-log.mjs"],
            "timeoutMs": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/verification-gate.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "Checking verification records..."
          }
        ]
      }
    ]
  }
}
