{
  "description": "Teamwork - exclusive file ownership, Bash write guard, and campaign context",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/session-context.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "Loading Teamwork charter..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/approval.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "Checking campaign approval..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/ownership-lock.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "Checking file ownership..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/bash-guard.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "Checking shell writes against file ownership..."
          }
        ]
      }
    ]
  }
}
